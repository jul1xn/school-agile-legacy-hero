@model List<ExcellentTaste.Core.Models.Medewerker>
@{ ViewData["Title"] = "Medewerkers"; }
<div class="container-fluid">
    <div class="clearfix">
        <a asp-action="Create" class="btn btn-primary pull-right">Medewerker toevoegen</a>
        <h2>Medewerkers</h2>
    </div>
    <p class="text-muted">Beheer de medewerkers die je in het rooster kunt plannen.</p>
    @if (ViewBag.ApiFout is string apiFout) { <div class="alert alert-warning" role="alert">@apiFout</div> }
    @if (TempData["Fout"] is string fout) { <div class="alert alert-danger" role="alert">@fout</div> }
    <div class="panel panel-default">
        @if (Model.Count == 0)
        {
            <div class="panel-body text-muted">Er zijn nog geen medewerkers toegevoegd.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead><tr><th scope="col">Naam</th><th scope="col">Functie</th><th scope="col">Status</th><th scope="col" class="text-right">Acties</th></tr></thead>
                    <tbody>
                    @foreach (var medewerker in Model)
                    {
                        <tr>
                            <td>@medewerker.Naam</td><td>@medewerker.Functie</td><td>@(medewerker.Actief ? "Actief" : "Inactief")</td>
                            <td class="text-right">
                                <a asp-action="Edit" asp-route-id="@medewerker.MedewerkerId" class="btn btn-xs btn-default">Wijzigen</a>
                                <form asp-action="Delete" asp-route-id="@medewerker.MedewerkerId" method="post" class="form-inline" onsubmit="return confirm('Weet je zeker dat je deze medewerker wilt verwijderen?');">
                                    <button type="submit" class="btn btn-xs btn-default">Verwijderen</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
