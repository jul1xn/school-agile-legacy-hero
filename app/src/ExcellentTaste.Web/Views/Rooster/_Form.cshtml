@model ExcellentTaste.Web.ViewModels.DienstFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="form-group">
    <label asp-for="MedewerkerId"></label>
    <select asp-for="MedewerkerId" asp-items="Model.Medewerkers" class="form-control">
        <option value="0">-- Kies een medewerker --</option>
    </select>
    <span asp-validation-for="MedewerkerId" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="StartTijd"></label>
    <input asp-for="StartTijd" type="datetime-local" class="form-control" />
    <span asp-validation-for="StartTijd" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="EindTijd"></label>
    <input asp-for="EindTijd" type="datetime-local" class="form-control" />
    <span asp-validation-for="EindTijd" class="text-danger"></span>
</div>
<p class="help-block">Het aantal uren wordt automatisch berekend met de begin- en eindtijd.</p>
<div>
    <button type="submit" class="btn btn-primary">Dienst opslaan</button>
    <a asp-controller="Rooster" asp-action="Index" class="btn btn-default">Annuleren</a>
</div>
